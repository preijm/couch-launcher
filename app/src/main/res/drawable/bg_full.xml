<?xml version="1.0" encoding="utf-8"?>
<!-- Background image with a darkening shade towards the bottom for readable tiles. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:src="@drawable/bg" android:gravity="fill" />
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#26050810"
                android:centerColor="#8C050810" android:endColor="#CC050810" />
        </shape>
    </item>
</layer-list>
