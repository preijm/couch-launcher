<?xml version="1.0" encoding="utf-8"?>
<!-- 1080p TV = 960x540dp. 64dp/44dp margins keep everything inside the overscan-safe area. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:clipChildren="false">

    <!-- Left: time, this week, buttons. 1920x1080 design / 2 = dp. -->
    <LinearLayout
        android:id="@+id/left"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textColor="@color/ink"
            android:textSize="84sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:textColor="#9A9A9A"
            android:textSize="15sp" />

        <!-- This week, as a card: OK opens the analysis. Pulled left by its padding so the text lines up. -->
        <LinearLayout
            android:id="@+id/weekCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="-16dp"
            android:background="@drawable/week_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/totalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:textColor="#9A9A9A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:text="–"
            android:textColor="@color/ink"
            android:textSize="48sp" />

        <nl.reijm.banklaunchtv.SegmentBar
            android:id="@+id/segments"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/perDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/weekHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OK  for more"
            android:textColor="#7A7A7A"
            android:textSize="11sp"
            android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/round_btn_bg"
                android:contentDescription="TV settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/round_btn_icon" />

            <ImageButton
                android:id="@+id/btnInputs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/round_btn_bg"
                android:contentDescription="Switch input"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tv"
                android:tint="@color/round_btn_icon" />

            <ImageButton
                android:id="@+id/btnApps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/round_btn_bg"
                android:contentDescription="All apps"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_grid"
                android:tint="@color/round_btn_icon" />

            <!-- Which speaker plays: the Bluetooth speaker (Sonos) or the TV. OK switches. -->
            <LinearLayout
                android:id="@+id/btnSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/pill_btn_bg"
                android:focusable="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/speakerIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speaker"
                    android:tint="@color/round_btn_icon" />

                <TextView
                    android:id="@+id/speakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:duplicateParentState="true"
                    android:textColor="@color/round_btn_icon"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Right: the apps -->
    <LinearLayout
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="404dp"
        android:layout_marginEnd="64dp"
        android:animateLayoutChanges="true"
        android:orientation="vertical" />

    <!-- Inputs / all apps: dims the home screen and shows a panel. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_bg"
            android:minWidth="360dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="22sp" />

            <ScrollView
                android:id="@+id/panelScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/panelBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
