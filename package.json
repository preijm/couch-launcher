{
  "name": "tegel",
  "version": "1.0.0",
  "private": true,
  "description": "Tegel - custom tile home screen for LG webOS TV (nl.reijm.tegel)",
  "scripts": {
    "package": "ares-package app -o dist",
    "install-tv": "node scripts/install.js",
    "launch": "ares-launch -d tv nl.reijm.tegel",
    "deploy": "npm run package && npm run install-tv && npm run launch",
    "inspect": "ares-inspect -d tv --app nl.reijm.tegel --open",
    "apps": "ares-install -d tv --listfull",
    "info": "ares-device -i -d tv",
    "serve": "npx --yes http-server app -p 5173 -c-1"
  }
}
